#include "bitboard.h"

namespace BB {

uint8_t  SquareDistance[64][64];
Bitboard BetweenBB[64][64];
Bitboard LineBB[64][64];
Bitboard PseudoAttacks[PIECE_TYPE_NB][64];
Bitboard PawnAttacks[COLOR_NB][64];

Magic RookMagics[64];
Magic BishopMagics[64];

static Bitboard RookTable[0x19000];
static Bitboard BishopTable[0x1480];

#ifndef USE_PEXT
// Classic magics (Kindergarten-free plain magics). Generated by search at init.
static uint64_t rng_state = 0x246C4E7BULL;
static uint64_t rng64() {
    rng_state ^= rng_state >> 12; rng_state ^= rng_state << 25; rng_state ^= rng_state >> 27;
    return rng_state * 2685821657736338717ULL;
}
static uint64_t sparse_rand() { return rng64() & rng64() & rng64(); }
#endif

// Generate sliding attacks the slow way, for table construction.
static Bitboard sliding_attack(PieceType pt, int sq, Bitboard occupied) {
    Bitboard attacks = 0;
    int RookDirs[4]   = { NORTH, SOUTH, EAST, WEST };
    int BishopDirs[4] = { NORTH_EAST, SOUTH_EAST, NORTH_WEST, SOUTH_WEST };
    const int* dirs = (pt == ROOK) ? RookDirs : BishopDirs;

    for (int i = 0; i < 4; ++i) {
        int d = dirs[i];
        int s = sq;
        while (true) {
            int next = s + d;
            if (next < 0 || next > 63) break;
            // reject wrap-around
            if (square_distance(s, next) > 2) break;
            if (std::abs(file_of(next) - file_of(s)) > 1) break;
            s = next;
            attacks |= square_bb(s);
            if (occupied & square_bb(s)) break;
        }
    }
    return attacks;
}

static void init_magics(PieceType pt, Bitboard table[], Magic magics[]) {
    Bitboard occupancy[4096], reference[4096];
    int size = 0;
    Bitboard* base = table;

    for (int s = 0; s < 64; ++s) {
        // Edges that are irrelevant for blocking from this square
        Bitboard edges = ((Rank1BB | Rank8BB) & ~rank_bb_of(s)) | ((FileABB | FileHBB) & ~file_bb_of(s));

        Magic& m = magics[s];
        m.mask = sliding_attack(pt, s, 0) & ~edges;
        m.attacks = base;
#ifndef USE_PEXT
        m.shift = 64 - popcount(m.mask);
#endif
        // Carry-rippler enumeration of all subsets of the mask
        Bitboard b = 0;
        size = 0;
        do {
            occupancy[size] = b;
            reference[size] = sliding_attack(pt, s, b);
#ifdef USE_PEXT
            m.attacks[_pext_u64(b, m.mask)] = reference[size];
#endif
            ++size;
            b = (b - m.mask) & m.mask;
        } while (b);

        base += size;

#ifndef USE_PEXT
        int epoch[4096]; std::memset(epoch, 0, sizeof(epoch));
        int cnt = 0;
        for (int i = 0; i < size; ) {
            for (m.magic = 0; popcount((m.magic * m.mask) >> 56) < 6; )
                m.magic = sparse_rand();
            for (++cnt, i = 0; i < size; ++i) {
                unsigned idx = m.index(occupancy[i]);
                if (epoch[idx] < cnt) { epoch[idx] = cnt; m.attacks[idx] = reference[i]; }
                else if (m.attacks[idx] != reference[i]) break;
            }
        }
#endif
    }
}

void init() {
    for (int a = 0; a < 64; ++a)
        for (int b = 0; b < 64; ++b)
            SquareDistance[a][b] = (uint8_t)std::max(std::abs(file_of(a) - file_of(b)),
                                                     std::abs(rank_of(a) - rank_of(b)));

    for (int s = 0; s < 64; ++s) {
        Bitboard b = square_bb(s);
        PawnAttacks[WHITE][s] = pawn_attacks_bb(WHITE, b);
        PawnAttacks[BLACK][s] = pawn_attacks_bb(BLACK, b);

        Bitboard n = 0, k = 0;
        int knightSteps[8] = { 17, 15, 10, 6, -6, -10, -15, -17 };
        int kingSteps[8]   = { 9, 8, 7, 1, -1, -7, -8, -9 };
        for (int i = 0; i < 8; ++i) {
            int t = s + knightSteps[i];
            if (is_ok_sq(t) && square_distance(s, t) <= 2) n |= square_bb(t);
            t = s + kingSteps[i];
            if (is_ok_sq(t) && square_distance(s, t) <= 2) k |= square_bb(t);
        }
        PseudoAttacks[KNIGHT][s] = n;
        PseudoAttacks[KING][s] = k;
    }

    init_magics(ROOK, RookTable, RookMagics);
    init_magics(BISHOP, BishopTable, BishopMagics);

    for (int s1 = 0; s1 < 64; ++s1) {
        PseudoAttacks[BISHOP][s1] = bishop_attacks(s1, 0);
        PseudoAttacks[ROOK][s1]   = rook_attacks(s1, 0);
        PseudoAttacks[QUEEN][s1]  = PseudoAttacks[BISHOP][s1] | PseudoAttacks[ROOK][s1];
    }

    for (int s1 = 0; s1 < 64; ++s1) {
        for (int s2 = 0; s2 < 64; ++s2) {
            BetweenBB[s1][s2] = 0;
            LineBB[s1][s2] = 0;
            if (s1 == s2) continue;
            for (PieceType pt : { BISHOP, ROOK }) {
                if (PseudoAttacks[pt][s1] & square_bb(s2)) {
                    LineBB[s1][s2] = (attacks_bb(pt, s1, 0) & attacks_bb(pt, s2, 0)) | square_bb(s1) | square_bb(s2);
                    BetweenBB[s1][s2] = attacks_bb(pt, s1, square_bb(s2)) & attacks_bb(pt, s2, square_bb(s1));
                }
            }
        }
    }
}

} // namespace BB
